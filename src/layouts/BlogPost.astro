---
import { getEntryTerms, type ContentEntry } from 'emdash';
import type { Post } from '../utils/posts';
import { formatDate, toDateAttr } from '../utils/posts';
import Layout from './Layout.astro';

interface Props {
	post: ContentEntry<Post>;
}

const { post } = Astro.props;
const { id, title, excerpt, publishedAt, featured_image } = post.data;
const tags = await getEntryTerms('posts', id, 'tag');
---

<Layout
	title={title}
	description={excerpt || undefined}
	image={featured_image?.src}
	type="article"
	publishedAt={publishedAt ?? undefined}
>
	<article>
		<header>
			<h1>{title}</h1>
			{
				publishedAt && (
					<p class="meta">
						<time datetime={toDateAttr(publishedAt)}>{formatDate(publishedAt)}</time>
					</p>
				)
			}
			{
				tags.length > 0 && (
					<ul class="tags">
						{tags.map((tag) => (
							<li>#{tag.label}</li>
						))}
					</ul>
				)
			}
		</header>
		<slot />
	</article>
	<p class="back"><a href="/blog/">Back to all posts</a></p>
</Layout>

<style>
	header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}

	h1 {
		margin-bottom: 0.5rem;
	}

	.meta {
		margin: 0;
		font-size: 0.85rem;
		color: var(--fg-muted);
	}

	.tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		margin: 0.75rem 0 0;
		font-size: 0.8rem;
		color: var(--fg-muted);
	}

	.back {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		font-size: 0.9rem;
	}
</style>
