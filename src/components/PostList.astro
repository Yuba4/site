---
import type { ContentEntry } from 'emdash';
import type { Post } from '../utils/posts';
import { formatDate, postHref, toDateAttr } from '../utils/posts';

interface Props {
	posts: ContentEntry<Post>[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
	{
		posts.map((post) => (
			<li>
				<a href={postHref(post.data)}>
					{post.data.publishedAt && (
						<time datetime={toDateAttr(post.data.publishedAt)}>
							{formatDate(post.data.publishedAt)}
						</time>
					)}
					<span class="title">{post.data.title}</span>
				</a>
				<p class="description">{post.data.excerpt}</p>
			</li>
		))
	}
</ul>

<style>
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	li {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--border);
	}

	li:first-child {
		padding-top: 0;
	}

	a {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		text-decoration: none;
		color: inherit;
	}

	time {
		font-size: 0.8rem;
		color: var(--fg-muted);
		font-variant-numeric: tabular-nums;
	}

	.title {
		font-weight: 600;
		line-height: 1.5;
	}

	a:hover .title {
		color: var(--accent);
	}

	.description {
		margin: 0.35rem 0 0;
		font-size: 0.9rem;
		color: var(--fg-muted);
		line-height: 1.7;
	}
</style>
