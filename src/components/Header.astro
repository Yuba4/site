---
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<div class="inner">
		<span class="site-title">{SITE_TITLE}</span>
		<nav>
			<ThemeToggle />
		</nav>
	</div>
</header>

<style>
	header {
		border-bottom: 1px solid var(--border);
	}

	.inner {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 1.25rem;
		display: flex;
		align-items: baseline;
		justify-content: flex-start;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.site-title {
		font-weight: 700;
		font-size: 1.05rem;
		margin-right: auto;
	}

	nav {
		display: flex;
		align-items: center;
	}
</style>
